{
  "name": "mixroute",
  "version": "0.2.0",
  "private": true,
  "description": "Simple AI Router — one model, multiple API keys, one endpoint, persistent context, automatic failover.",
  "type": "module",
  "bin": {
    "mixr": "./bin/mixr.mjs"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter server --filter web dev",
    "build": "pnpm --filter server build && pnpm --filter web build",
    "start": "pnpm --filter server start",
    "mixr": "node bin/mixr.mjs",
    "test": "pnpm --filter server test",
    "typecheck": "pnpm -r typecheck"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin/",
    "apps/server/dist/",
    "apps/web/dist/"
  ],
  "packageManager": "pnpm@12.8.1"
}
