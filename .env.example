# Server
PORT=3000
HOST=0.0.0.0

# Data directory (SQLite database + generated encryption key live here)
DATA_DIR=./.data

# 32-byte hex key for encrypting provider API keys at rest.
# If unset, a key file is generated automatically in DATA_DIR.
ENCRYPTION_KEY=

# Admin UI password
ADMIN_PASSWORD=admin

# Optional: comma-separated origins for CORS (defaults to same-origin only)
CORS_ORIGINS=
